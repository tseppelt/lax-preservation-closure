@article{arvind_weisfeiler-leman_2020,
	title = {On {Weisfeiler}-{Leman} invariance: {Subgraph} counts and related graph properties},
	volume = {113},
	issn = {00220000},
	shorttitle = {On {Weisfeiler}-{Leman} invariance},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0022000020300386},
	doi = {10.1016/j.jcss.2020.04.003},
	abstract = {The k-dimensional Weisfeiler-Leman algorithm (k-WL) is a fruitful approach to the Graph Isomorphism problem. 2-WL corresponds to the original algorithm suggested by Weisfeiler and Leman over 50 years ago. 1-WL is the classical color reﬁnement routine. Indistinguishability by k-WL is an equivalence relation on graphs that is of fundamental importance for isomorphism testing, descriptive complexity theory, and graph similarity testing which is also of some relevance in artiﬁcial intelligence. Focusing on dimensions k = 1, 2, we investigate subgraph patterns whose counts are k-WL invariant, and whose occurrence is k-WL invariant. We achieve a complete description of all such patterns for dimension k = 1 and considerably extend the previous results known for k = 2.},
	language = {en},
	urldate = {2020-06-07},
	journal = {Journal of Computer and System Sciences},
	author = {Arvind, V. and Fuhlbrück, Frank and Köbler, Johannes and Verbitsky, Oleg},
	month = nov,
	year = {2020},
	pages = {42--59},
	
}
