@article{dawar_limitations_2022,
	title = {Limitations of the invertible-map equivalences},
	issn = {0955-792X},
	url = {https://doi.org/10.1093/logcom/exac058},
	doi = {10.1093/logcom/exac058},
	abstract = {This note draws conclusions that arise by combining two recent papers, by Anuj Dawar, Erich Gr{\"a}del and Wied Pakusa, published at ICALP 2019, and by Moritz Lichter, published at LICS 2021. In both papers, the main technical results rely on the combinatorial and algebraic analysis of the invertible-map equivalences \$\{{\textbackslash}equiv {\textasciicircum}\{{\textbackslash}text \{IM\}\}\_\{k, Q\}\}\$ on certain variants of Cai{\textendash}F{\"u}rer{\textendash}Immerman structures (CFI-structures for short). These \$\{{\textbackslash}equiv {\textasciicircum}\{{\textbackslash}text \{IM\}\}\_\{k, Q\}\}\$-equivalences, for a natural number \$k\$ and a set of primes \$Q\$, refine the well-known Weisfeiler{\textendash}Leman equivalences used in algorithms for graph isomorphism. The intuition is that two graphs \$G\{{\textbackslash}equiv {\textasciicircum}\{{\textbackslash}text \{IM\}\}\_\{k, Q\}\}H\$ cannot be distinguished by iterative refinements of equivalences on \$k\$-tuples defined via linear operators on vector spaces over fields of characteristic \$p {\textbackslash}in Q\$. In the first paper it has been shown, using considerable algebraic machinery, that for a prime \$q {\textbackslash}notin Q\$, the \$\{{\textbackslash}equiv {\textasciicircum}\{{\textbackslash}text \{IM\}\}\_\{k, Q\}\}\$ equivalences are not strong enough to distinguish between non-isomorphic CFI-structures over the field \${\textbackslash}mathbb \{F\}\_q\$. In the second paper, a similar but not identical construction for CFI-structures over the rings \${\textbackslash}mathbb \{Z\}\_\{2{\textasciicircum}i\}\$ has, again by rather involved combinatorial and algebraic arguments, been shown to be indistinguishable with respect to \$\{{\textbackslash}equiv {\textasciicircum}\{{\textbackslash}text \{IM\}\}\_\{k, {\textbackslash}\{2{\textbackslash}\}\}\}\$. Together with an earlier work on rank logic, this second result suffices to separate rank logic from polynomial time. We show here that the two approaches can be unified to prove that CFI-structures over the rings \${\textbackslash}mathbb \{Z\}\_\{2{\textasciicircum}i\}\$ are in fact indistinguishable with respect to \$\{{\textbackslash}equiv {\textasciicircum}\{{\textbackslash}text \{IM\}\}\_\{k, \{{\textbackslash}mathbb \{P\}\}\}\}\$, for the set \$\{{\textbackslash}mathbb \{P\}\}\$ of all primes. In particular, this implies the following two results. First, there is no fixed \$k\$ such that the invertible-map equivalence \$\{{\textbackslash}equiv {\textasciicircum}\{{\textbackslash}text \{IM\}\}\_\{k, \{{\textbackslash}mathbb \{P\}\}\}\}\$ coincides with isomorphism on all finite graphs. Second, no extension of fixed-point logic by linear-algebraic operators over fields can capture polynomial time.},
urldate = {2023-11-05},
journal = {Journal of Logic and Computation},
author = {Dawar, Anuj and Gr{\"a}del, Erich and Lichter, Moritz},
month = sep,
year = {2022},

}


